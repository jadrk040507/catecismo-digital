<tr><th style="padding:6px;border:1px solid var(--border);text-align:left">Vicio Capital</th><th style="padding:6px;border:1px solid var(--border);text-align:left">Remedio (virtud + acción concreta)</th></tr>
<tr><td style="padding:6px;border:1px solid var(--border)">Soberbia</td><td style="padding:6px;border:1px solid var(--border)"></td></tr>
<tr><td style="padding:6px;border:1px solid var(--border)">Avaricia</td><td style="padding:6px;border:1px solid var(--border)"></td></tr>
