# TinaCMS Environment Variables
# Copy this to .env and fill in your values

# --- LOCAL DEVELOPMENT ---
# Set to 'true' for local file-system content management (no auth needed)
TINA_PUBLIC_IS_LOCAL=true

# --- PRODUCTION (Tina Cloud) ---
# Get these from https://app.tina.io
# TINA_CLIENT_ID=your-client-id
# TINA_TOKEN=your-token
# TINA_SEARCH_TOKEN=your-search-token

# --- GITHUB AUTH (for Tina Cloud) ---
# Set up a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL: https://content.tina.io/auth/{your-client-id}/callback
# TINA_CLIENT_ID=your-client-id
# TINA_TOKEN=your-token

# --- ASTRO ---
PUBLIC_TINA_EDITOR_URL=http://localhost:4321
