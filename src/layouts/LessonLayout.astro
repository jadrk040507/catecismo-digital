---
export interface Props {
  title: string;
  cic: string;
  scripture: string;
}

const { title, cic, scripture } = Astro.props;
const path = Astro.url.pathname;
const isEn = path.startsWith('/catecismo-digital/en');
const sections = ['credo', 'sacramentos', 'moral', 'oracion'];
const foundSection = sections.find(s => path.includes('/' + s + '/'));
const toggleHref = isEn
  ? '/catecismo-digital/es/' + (foundSection || 'credo') + '/'
  : '/catecismo-digital/en/' + (foundSection || 'credo') + '/';
const toggleLabel = isEn ? 'ES' : 'EN';

// Translation strings
const t = {
  siteTitle: isEn ? "Catechism Project" : "Proyecto Catecismo",
  menuHome: isEn ? "Home" : "Inicio",
  menuCreed: isEn ? "Creed" : "Credo",
  menuSacraments: isEn ? "Sacraments" : "Sacramentos",
  menuMoral: isEn ? "Moral" : "Moral",
  menuPrayer: isEn ? "Prayer" : "Oracion",
  footerLine1: isEn ? "Free &middot; Public &middot; Catholic &middot;" : "Gratuito &middot; P" + String.fromCharCode(250) + "blico &middot; Cat" + String.fromCharCode(243) + "lico &middot;",
  footerLine2: isEn ? "Based on the Catechism of the Catholic Church &middot; Directory for Catechesis (2020)" : "Basado en el Catecismo de la Iglesia Cat" + String.fromCharCode(243) + "lica &middot; Directorio para la Catequesis (2020)",
  menuToggleOpen: isEn ? "Open menu" : "Abrir men" + String.fromCharCode(250),
  menuToggleClose: isEn ? "Close menu" : "Cerrar men" + String.fromCharCode(250),
  ttsPlay: isEn ? "Listen" : "Escuchar",
  ttsPause: isEn ? "Pause" : "Pausar",
  ttsResume: isEn ? "Continue" : "Continuar",
  ttsSkipBack: isEn ? "Rewind 10 seconds" : "Retroceder 10 segundos",
  ttsSkipForward: isEn ? "Forward 10 seconds" : "Adelantar 10 segundos",
};
const homePrefix = isEn ? '/catecismo-digital/en/' : '/catecismo-digital/';
const linkPrefix = isEn ? '/catecismo-digital/en' : '/catecismo-digital/es';
const backHref = isEn ? '/catecismo-digital/en/' : '/catecismo-digital/';

// Compute workbook/guide links and current topic slug
const cleanPath = path.endsWith('/') ? path.slice(0, -1) : path;
const pathParts = cleanPath.split('/');
const lastSegment = pathParts[pathParts.length - 1] || '';
const isWorkbookOrGuide = lastSegment.endsWith('-workbook') || lastSegment.endsWith('-guide');

// Extract the topic slug (last segment), removing trailing number-dash if present
const topicSlug = lastSegment.replace(/-(workbook|guide)$/, '');
const parentPath = pathParts.slice(0, -1).join('/');

let navLessonUrls = { workbook: '', guide: '' };
let navLabels = { workbook: '', guide: '' };

if (!isWorkbookOrGuide) {
  // Topic page itself: link to -workbook and -guide in same directory
  navLessonUrls.workbook = `${cleanPath}-workbook`;
  navLessonUrls.guide = `${cleanPath}-guide`;
  navLabels.workbook = isEn ? 'Workbook' : 'Cuaderno';
  navLabels.guide = isEn ? "Catechist's Guide" : 'Guía del Catequista';
} else {
  // Workbook or guide page: link back to lesson and the other resource
  navLessonUrls.lesson = `${parentPath}/${topicSlug}`;
  navLabels.lesson = isEn ? 'Lesson' : 'Lección';
  
  if (lastSegment.endsWith('-workbook')) {
    navLessonUrls.other = `${parentPath}/${topicSlug}-guide`;
    navLabels.other = isEn ? "Catechist's Guide" : 'Guía del Catequista';
  } else {
    navLessonUrls.other = `${parentPath}/${topicSlug}-workbook`;
    navLabels.other = isEn ? 'Workbook' : 'Cuaderno';
  }
}
---
<!DOCTYPE html>
<html lang={Astro.currentLocale || (isEn ? 'en' : 'es')} data-is-en={isEn ? 'true' : 'false'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title set:html={title + ' &mdash; ' + t.siteTitle}></title>
  <meta name="description" content="Catequesis catolica gratuita" />
  <link rel="icon" type="image/svg+xml" href="/catecismo-digital/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/catecismo-digital/styles/global.css" />
</head>
<body>
  <header class="header">
    <nav class="header__nav">
      <a href={backHref} class="header__logo">
        <span class="header__logo-icon">+</span>
        <span set:html={t.siteTitle}></span>
      </a>
      <button class="header__toggle" data-toggle-menu aria-label={t.menuToggleOpen} type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="header__links">
        <a href={homePrefix} class="header__link" set:html={t.menuHome}></a>
        <a href={linkPrefix + '/credo/'} class="header__link" set:html={t.menuCreed}></a>
        <a href={linkPrefix + '/sacramentos/'} class="header__link" set:html={t.menuSacraments}></a>
        <a href={linkPrefix + '/moral/'} class="header__link" set:html={t.menuMoral}></a>
        <a href={linkPrefix + '/oracion/'} class="header__link" set:html={t.menuPrayer}></a>
        <a href={toggleHref} class="header__link header__link--lang">{toggleLabel}</a>
      </div>
    </nav>
  </header>

  <main class="main">
    <header class="lesson-header">
      <div class="lesson-header__ref">
        <span>{cic}</span>
        <span>{scripture}</span>
      </div>
      <h1 class="lesson-header__title">{title}</h1>
      <div class="tts-controls">
        <button class="tts-btn tts-btn--skip" data-skip-back aria-label={t.ttsSkipBack} title={t.ttsSkipBack}>
          <svg class="tts-btn__icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
            <text x="12" y="14" text-anchor="middle" font-size="6" font-weight="bold">10</text>
          </svg>
        </button>
        <button class="tts-btn tts-btn--play" data-play aria-label={t.ttsPlay}>
          <svg class="tts-btn__icon tts-btn__icon--play" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg class="tts-btn__icon tts-btn__icon--pause" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="display:none">
            <rect x="6" y="4" width="4" height="16"/>
            <rect x="14" y="4" width="4" height="16"/>
          </svg>
          <span class="tts-btn__label" set:html={t.ttsPlay}></span>
        </button>
        <button class="tts-btn tts-btn--skip" data-skip-forward aria-label={t.ttsSkipForward} title={t.ttsSkipForward}>
          <svg class="tts-btn__icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M12 5V1l5 5-5 5V7c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z"/>
            <text x="12" y="14" text-anchor="middle" font-size="6" font-weight="bold">10</text>
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <!-- Bottom navigation: workbook / guide links -->
    {
      !isWorkbookOrGuide && (
        <div class="lesson-bottom-nav">
          <a href={navLessonUrls.workbook} class="lesson-bottom-nav__btn lesson-bottom-nav__btn--workbook">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/></svg>
            <span>{navLabels.workbook}</span>
          </a>
          <a href={navLessonUrls.guide} class="lesson-bottom-nav__btn lesson-bottom-nav__btn--guide">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.15 4.75.35.15.05.3.05.45.05.25 0 .5-.15.5-.35V6c-.6-.45-1.25-.75-2-1zM18 19.5c-1.4 0-3.05.35-4.5 1.2V8.5c1.45-.85 3.1-1.2 4.5-1.2s3.05.35 4.5 1.2v12.2c-1.35-.6-2.9-1-4.5-1zm-9-13.2c1.45 0 3.05.35 4.5 1.2v12.2c-1.45-.85-3.05-1.2-4.5-1.2s-3.05.35-4.5 1.2V7.5c1.45-.85 3.05-1.2 4.5-1.2z"/></svg>
            <span>{navLabels.guide}</span>
          </a>
        </div>
      )
    }
    {
      isWorkbookOrGuide && (
        <div class="lesson-bottom-nav">
          <a href={navLessonUrls.lesson} class="lesson-bottom-nav__btn lesson-bottom-nav__btn--back">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            <span>{navLabels.lesson}</span>
          </a>
          <a href={navLessonUrls.other} class="lesson-bottom-nav__btn lesson-bottom-nav__btn--other">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/></svg>
            <span>{navLabels.other}</span>
          </a>
        </div>
      )
    }

    <div class="tts-progress">
      <div class="tts-progress__bar" id="tts-progress-bar"></div>
    </div>
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <p class="footer__text" set:html={t.footerLine1 + ' <a href="https://github.com/jadrk040507/catecismo-digital" class="footer__link">GitHub</a>'}></p>
      <p class="footer__text footer__text--small" set:html={t.footerLine2}></p>
    </div>
  </footer>

  <audio id="tts-audio" style="display:none"></audio>

  <script is:inline>
(function() {
  const isEn = document.documentElement.getAttribute('data-is-en') === 'true';
  const t = {
    play: isEn ? "Listen" : "Escuchar",
    pause: isEn ? "Pause" : "Pausar",
    resume: isEn ? "Continue" : "Continuar",
    stopped: isEn ? "Listen" : "Escuchar",
  };

  // Elements
  const playBtn = document.querySelector('[data-play]');
  const skipBackBtn = document.querySelector('[data-skip-back]');
  const skipForwardBtn = document.querySelector('[data-skip-forward]');
  const audioEl = document.getElementById('tts-audio');
  const progressBar = document.getElementById('tts-progress-bar');

  if (!playBtn) return;

  // State
  let speaking = false;
  let paused = false;
  let currentSegment = 0;
  let segments = [];
  let totalSegments = 0;

  // Get text segments (split by paragraphs and headings)
  function getSegments() {
    const main = document.querySelector('.main');
    if (!main) return [];
    
    const clone = main.cloneNode(true);
    clone.querySelectorAll('.tts-btn, .tts-controls, .tts-progress, .lesson-header__ref, .lesson-header__title, .downloads, script, style').forEach(function(el) { el.remove(); });
    
    var segs = [];
    var elements = clone.querySelectorAll('h2, h3, p, .depth-box');
    elements.forEach(function(el) {
      var text = (el.textContent || '').trim();
      if (text.length > 10) {
        // Split long paragraphs
        if (text.length > 1000) {
          var sentences = text.match(/[^.!?]+[.!?]+/g);
          if (sentences) {
            var chunk = '';
            sentences.forEach(function(s) {
              if ((chunk + s).length > 600) {
                if (chunk.trim()) segs.push(chunk.trim());
                chunk = s;
              } else {
                chunk += s;
              }
            });
            if (chunk.trim()) segs.push(chunk.trim());
          } else {
            segs.push(text);
          }
        } else {
          segs.push(text);
        }
      }
    });
    return segs;
  }

  // Play a segment via Edge TTS (via Cloudflare tunnel)
  function playSegment(index) {
    if (index >= segments.length) {
      stopAll();
      return;
    }
    
    currentSegment = index;
    var text = segments[index];
    
    fetch('https://tts.artesanosqueseros.com/tts?text=' + encodeURIComponent(text) + '&lang=' + (isEn ? 'en' : 'es'))
      .then(function(r) {
        if (!r.ok) throw new Error('TTS server error');
        return r.blob();
      })
      .then(function(blob) {
        if (audioEl.src) URL.revokeObjectURL(audioEl.src);
        var url = URL.createObjectURL(blob);
        audioEl.src = url;
        audioEl.play();
        speaking = true;
        paused = false;
        updateUI('playing');
      })
      .catch(function(err) {
        console.error('TTS error:', err);
        stopAll();
      });
  }

  // Update UI
  function updateUI(state) {
    var playIcon = playBtn.querySelector('.tts-btn__icon--play');
    var pauseIcon = playBtn.querySelector('.tts-btn__icon--pause');
    var label = playBtn.querySelector('.tts-btn__label');
    
    if (state === 'playing') {
      playBtn.classList.add('tts-btn--playing');
      if (playIcon) playIcon.style.display = 'none';
      if (pauseIcon) pauseIcon.style.display = 'block';
      if (label) label.textContent = t.pause;
    } else if (state === 'paused') {
      playBtn.classList.add('tts-btn--playing');
      if (playIcon) playIcon.style.display = 'block';
      if (pauseIcon) pauseIcon.style.display = 'none';
      if (label) label.textContent = t.resume;
    } else {
      playBtn.classList.remove('tts-btn--playing');
      if (playIcon) playIcon.style.display = 'block';
      if (pauseIcon) pauseIcon.style.display = 'none';
      if (label) label.textContent = t.stopped;
      if (progressBar) progressBar.style.width = '0%';
    }
  }

  // Update progress
  function updateProgress() {
    if (!progressBar || totalSegments === 0) return;
    var pct = Math.min(100, Math.round((currentSegment / totalSegments) * 100));
    progressBar.style.width = pct + '%';
  }

  // Stop all playback
  function stopAll() {
    if (audioEl) {
      audioEl.pause();
      audioEl.src = '';
    }
    speaking = false;
    paused = false;
    currentSegment = 0;
    updateUI('stopped');
  }

  // Audio element events
  if (audioEl) {
    audioEl.onended = function() {
      // Play next segment
      if (currentSegment < segments.length - 1) {
        playSegment(currentSegment + 1);
        updateProgress();
      } else {
        speaking = false;
        paused = false;
        currentSegment = 0;
        updateUI('stopped');
      }
    };
    
    audioEl.onerror = function() {
      // Try next segment on error
      if (currentSegment < segments.length - 1) {
        playSegment(currentSegment + 1);
      } else {
        stopAll();
      }
    };
    
    audioEl.onplay = function() {
      speaking = true;
      paused = false;
      updateUI('playing');
    };
    
    audioEl.onpause = function() {
      paused = true;
      updateUI('paused');
    };
  }

  // Play/Pause button
  playBtn.addEventListener('click', function() {
    if (segments.length === 0) {
      segments = getSegments();
      totalSegments = segments.length;
    }
    
    if (totalSegments === 0) return;

    if (speaking && !paused) {
      audioEl.pause();
    } else if (paused) {
      audioEl.play();
    } else {
      playSegment(0);
    }
  });

  // Skip back 10s
  if (skipBackBtn) {
    skipBackBtn.addEventListener('click', function() {
      if (!audioEl.src) return;
      audioEl.currentTime = Math.max(0, (audioEl.currentTime || 0) - 10);
    });
  }

  // Skip forward 10s
  if (skipForwardBtn) {
    skipForwardBtn.addEventListener('click', function() {
      if (!audioEl.src) return;
      audioEl.currentTime = Math.min(audioEl.duration || Infinity, (audioEl.currentTime || 0) + 10);
    });
  }
})();
  </script>
  <script is:inline>
    document.querySelector('[data-toggle-menu]')?.addEventListener('click', function() {
      var nav = this.closest('.header__nav');
      var links = nav?.querySelector('.header__links');
      var isOpen = this.classList.contains('header__toggle--open');
      if (links) {
        this.classList.toggle('header__toggle--open');
        links.classList.toggle('header__links--open');
      }
    });
  </script>
</body>
</html>
