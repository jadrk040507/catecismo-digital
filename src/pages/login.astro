---
import BaseLayout from '../layouts/BaseLayout.astro';

const path = Astro.url.pathname;
const isEn = path.startsWith('/en');
// In static build, redirect param comes from client; default to home
const defaultHome = isEn ? '/en/' : '/';
const t = {
  title: isEn ? 'Login' : 'Ingresar',
  email: isEn ? 'Email' : 'Correo electrónico',
  password: isEn ? 'Password' : 'Contraseña',
  submit: isEn ? 'Sign in' : 'Iniciar sesión',
  noAccount: isEn ? "Don't have an account?" : '¿No tienes cuenta?',
  register: isEn ? 'Create one' : 'Crear una',
  loginError: isEn ? 'Invalid email or password. Please try again.' : 'Correo o contraseña incorrectos. Intenta de nuevo.',
  genericError: isEn ? 'An error occurred. Please try again.' : 'Ocurrió un error. Intenta de nuevo.',
};
const registerHref = isEn ? '/en/register/' : '/register/';
---

<BaseLayout title={t.title}>
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card__title">{t.title}</h1>

      <form id="login-form" class="auth-form" novalidate>
        <div class="auth-form__field">
          <label for="email" class="auth-form__label">{t.email}</label>
          <input type="email" id="email" name="email" class="auth-form__input"
                 autocomplete="email" required autofocus />
        </div>

        <div class="auth-form__field">
          <label for="password" class="auth-form__label">{t.password}</label>
          <input type="password" id="password" name="password" class="auth-form__input"
                 autocomplete="current-password" required minlength="6" />
        </div>

        <div id="login-error" class="auth-form__error" hidden></div>

        <button type="submit" class="auth-form__submit">{t.submit}</button>
      </form>

      <p class="auth-card__footer">
        {t.noAccount} <a href={registerHref}>{t.register}</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // Determine default redirect from path
    var path = window.location.pathname;
    var isEn = path.startsWith('/en');
    var defaultHome = isEn ? '/en/' : '/';
    var redirect = (function () {
      var params = new URLSearchParams(window.location.search);
      return params.get('redirect') || defaultHome;
    })();
    var errorMsg = document.getElementById('login-error');
    var form = document.getElementById('login-form');
    var submitBtn = form.querySelector('.auth-form__submit');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errorMsg.hidden = true;

      var email = document.getElementById('email').value.trim();
      var password = document.getElementById('password').value;

      if (!email || !password) {
        errorMsg.textContent = isEn
          ? 'Please fill in all fields.'
          : 'Por favor completa todos los campos.';
        errorMsg.hidden = false;
        return;
      }

      if (!window.CatecismoAuth) {
        errorMsg.textContent = isEn
          ? 'Auth system not loaded. Please refresh.'
          : 'Sistema de autenticación no cargado. Refresca la página.';
        errorMsg.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = isEn ? 'Signing in…' : 'Iniciando sesión…';

      window.CatecismoAuth.login(email, password)
        .then(function (user) {
          window.location.href = redirect;
        })
        .catch(function (err) {
          errorMsg.textContent = err.message || (isEn
            ? 'Invalid email or password. Please try again.'
            : 'Correo o contraseña incorrectos. Intenta de nuevo.');
          errorMsg.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = isEn ? 'Sign in' : 'Iniciar sesión';
        });
    });
  })();
</script>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 24px 16px;
  }
  .auth-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px 28px;
    max-width: 400px;
    width: 100%;
    box-shadow: 0 2px 12px rgba(0,0,0,.04);
  }
  .auth-card__title {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 24px;
    color: var(--text);
  }
  .auth-form__field {
    margin-bottom: 16px;
  }
  .auth-form__label {
    display: block;
    font-size: .82rem;
    font-weight: 500;
    color: var(--text-soft);
    margin-bottom: 6px;
  }
  .auth-form__input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--sans);
    font-size: .9rem;
    color: var(--text);
    background: var(--bg);
    transition: border-color .2s;
  }
  .auth-form__input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--gold-light);
  }
  .auth-form__error {
    background: #fef2f2;
    color: #991b1b;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: .82rem;
    margin-bottom: 16px;
    border: 1px solid #fecaca;
  }
  .auth-form__submit {
    width: 100%;
    padding: 12px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--sans);
    font-size: .92rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .2s;
    margin-top: 8px;
  }
  .auth-form__submit:hover:not(:disabled) {
    background: var(--accent-dark);
  }
  .auth-form__submit:disabled {
    opacity: .6;
    cursor: not-allowed;
  }
  .auth-card__footer {
    text-align: center;
    margin-top: 20px;
    font-size: .82rem;
    color: var(--text-soft);
  }
  .auth-card__footer a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .auth-card__footer a:hover {
    text-decoration: underline;
  }
</style>
