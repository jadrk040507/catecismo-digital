---
export interface Props {
  title?: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const isEn = path.startsWith('/en');
// Language toggle: preserve full path, just swap /es/ ↔ /en/
// Spanish home is /, sections are /es/credo/, /es/sacramentos/, etc.
// English home is /en/, sections are /en/credo/, /en/sacramentos/, etc.
const toggleHref = (function() {
  if (path === '/') return '/en/';
  if (path.startsWith('/es/')) return '/en' + path.slice(3);
  if (path.startsWith('/en/')) return '/es' + path.slice(3);
  if (path === '/en') return '/';
  // fallback
  return '/en/';
})();
const toggleLabel = isEn ? 'ES' : 'EN';

// Translation strings
const t = {
  siteTitle: isEn ? 'Catechism Project' : 'Proyecto Catecismo',
  menuHome: isEn ? 'Home' : 'Inicio',
  menuCreed: isEn ? 'Creed' : 'Credo',
  menuSacraments: isEn ? 'Sacraments' : 'Sacramentos',
  menuMoral: isEn ? 'Moral' : 'Moral',
  menuPrayer: isEn ? 'Prayer' : 'Oracion',
  footerLine1: isEn ? 'Free &middot; Public &middot; Catholic &middot;' : 'Gratuito &middot; P\u00fablico &middot; Cat\u00f3lico &middot;',
  footerLine2: isEn ? 'Based on the Catechism of the Catholic Church &middot; Directory for Catechesis (2020)' : 'Basado en el Catecismo de la Iglesia Cat\u00f3lica &middot; Directorio para la Catequesis (2020)',
  menuToggleOpen: isEn ? 'Open menu' : 'Abrir men\u00fa',
  menuToggleClose: isEn ? 'Close menu' : 'Cerrar men\u00fa',
  login: isEn ? 'Login' : 'Ingresar',
  siteDescription: isEn ? 'Free, clear, and deep Catholic catechesis for all ages' : 'Catequesis cat\u00f3lica gratuita, clara y profunda para todas las edades',
};
const homePrefix = isEn ? '/en/' : '/';
const linkPrefix = isEn ? '/en' : '/es';
---
<!DOCTYPE html>
<html lang={Astro.currentLocale || (isEn ? 'en' : 'es')} data-lang={isEn ? 'en' : 'es'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? title + ' &mdash; ' + t.siteTitle : t.siteTitle}</title>
  <meta name="description" content={t.siteDescription} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="stylesheet" href="/styles/progress.css" />
</head>
<body>
  <header class="header">
    <nav class="header__nav">
      <a href="/" class="header__logo">
        <span class="header__logo-icon">+</span>
        <span set:html={t.siteTitle}></span>
      </a>
      <button class="header__toggle" data-toggle-menu aria-label={t.menuToggleOpen} type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="header__links">
        <a href={homePrefix} class="header__link" set:html={t.menuHome}></a>
        <a href={linkPrefix + '/credo/'} class="header__link" set:html={t.menuCreed}></a>
        <a href={linkPrefix + '/sacramentos/'} class="header__link" set:html={t.menuSacraments}></a>
        <a href={linkPrefix + '/moral/'} class="header__link" set:html={t.menuMoral}></a>
        <a href={linkPrefix + '/oracion/'} class="header__link" set:html={t.menuPrayer}></a>
      </div>
      <div class="header__actions">
        <a href="#" class="header__link header__link--lang header__link--auth" role="button" tabindex="0" data-auth-button>{t.login}</a>
        <a href={toggleHref} class="header__link header__link--lang">{toggleLabel}</a>
      </div>
    </nav>
  </header>

  <main class="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <p class="footer__text" set:html={t.footerLine1 + ' <a href="https://github.com/jadrk040507/" class="footer__link">GitHub</a>'}></p>
      <p class="footer__text footer__text--small" set:html={t.footerLine2}></p>
    </div>
  </footer>

  <script src="/scripts/supabase-client.js" defer></script>
  <script is:inline>
(function () {
  'use strict';

  function getLang() {
    return document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'es';
  }

  var L = {
    es: { login: 'Ingresar', logout: 'Cerrar sesión', progress: 'Mi Progreso', dashboard: 'Dashboard' },
    en: { login: 'Login', logout: 'Log out', progress: 'My Progress', dashboard: 'Dashboard' }
  };
  function t(key, lang) { lang = lang || getLang(); return (L[lang] && L[lang][key]) || L.es[key] || key; }

  var authBtn = null, dropdownEl = null;

  if (!document.getElementById('auth-ui-styles')) {
    var style = document.createElement('style');
    style.id = 'auth-ui-styles';
    style.textContent = '.header__link--auth{position:relative;cursor:pointer;user-select:none}.header__link--auth--logged-in{display:inline-flex;align-items:center;gap:6px}.header__auth-avatar{width:20px;height:20px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;flex-shrink:0;line-height:1}.header__auth-name{max-width:90px;overflow:hidden;text-overflow:ellipsis}.header__auth-dropdown{display:none;position:absolute;top:calc(100% + 6px);right:0;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 4px 16px rgba(0,0,0,.1);min-width:180px;z-index:120;padding:4px 0}.header__auth-dropdown--open{display:block}.header__auth-dropdown a,.header__auth-dropdown button{display:block;width:100%;text-align:left;padding:8px 16px;border:none;background:none;cursor:pointer;font-family:inherit;font-size:.82rem;color:var(--text);text-decoration:none;transition:background .15s}.header__auth-dropdown a:hover,.header__auth-dropdown button:hover{background:var(--gold-light)}.header__auth-dropdown-divider{height:1px;background:var(--border);margin:4px 0}';
    document.head.appendChild(style);
  }

  function getInitial(name) { return name ? name.charAt(0).toUpperCase() : '?'; }

  function updateUI() {
    if (!authBtn) return;
    var lang = getLang();
    var loggedIn = window.CatecismoAuth && window.CatecismoAuth.isLoggedIn && window.CatecismoAuth.isLoggedIn();
    if (loggedIn) {
      var sess = window.CatecismoAuth.getSession();
      var profile = sess ? sess.profile : null;
      var name = (profile && profile.full_name) || (profile && profile.email) || '';
      if (name.length > 15) name = name.substring(0, 14) + '\u2026';
      var initial = getInitial(profile && profile.full_name);
      authBtn.innerHTML = '<span class="header__auth-avatar">' + initial + '</span><span class="header__auth-name">' + name + '</span>';
      authBtn.classList.add('header__link--auth--logged-in');
      authBtn.href = '#';
      dropdownEl = null;
      dropdownEl = document.createElement('div');
      dropdownEl.className = 'header__auth-dropdown';
      authBtn.appendChild(dropdownEl);
      var dash = window.CatecismoAuth.isAdmin() ? '<a href="/dashboard/">' + t('dashboard', lang) + '</a><div class="header__auth-dropdown-divider"></div>' : '';
      dropdownEl.innerHTML = dash + '<a href="/es/perfil/">' + t('progress', lang) + '</a><div class="header__auth-dropdown-divider"></div><button type="button" data-auth-logout>' + t('logout', lang) + '</button>';
      dropdownEl.querySelector('[data-auth-logout]').addEventListener('click', function (e) {
        e.stopPropagation();
        window.CatecismoAuth.logout().then(function () { dropdownEl.classList.remove('header__auth-dropdown--open'); });
      });
    } else {
      authBtn.textContent = t('login', lang);
      authBtn.classList.remove('header__link--auth--logged-in');
      authBtn.href = getLang() === 'en' ? '/en/login/' : '/login/';
      if (dropdownEl) { dropdownEl.remove(); dropdownEl = null; }
    }
  }

  function onToggleClick(e) {
    e.preventDefault(); e.stopPropagation();
    if (!(window.CatecismoAuth && window.CatecismoAuth.isLoggedIn && window.CatecismoAuth.isLoggedIn())) {
      window.location.href = getLang() === 'en' ? '/en/login/' : '/login/';
      return;
    }
    if (!dropdownEl) return;
    var isOpen = dropdownEl.classList.contains('header__auth-dropdown--open');
    if (isOpen) dropdownEl.classList.remove('header__auth-dropdown--open');
    else dropdownEl.classList.add('header__auth-dropdown--open');
  }

  function onOutsideClick(e) {
    if (dropdownEl && dropdownEl.classList.contains('header__auth-dropdown--open') && !authBtn.contains(e.target)) {
      dropdownEl.classList.remove('header__auth-dropdown--open');
    }
  }

  function init() {
    authBtn = document.querySelector('[data-auth-button]') || document.querySelector('.header__link--auth');
    if (!authBtn) { setTimeout(init, 50); return; }
    authBtn.addEventListener('click', onToggleClick);
    document.addEventListener('click', onOutsideClick);

    function tryUpdate() {
      if (window.CatecismoAuth && window.CatecismoAuth.isLoggedIn && window.CatecismoAuth.isLoggedIn()) {
        updateUI(); return true;
      }
      return false;
    }

    if (window.CatecismoAuth) {
      window.CatecismoAuth.onAuthChange(function () { updateUI(); });
    }

    if (!tryUpdate()) {
      var count = 0;
      var iv = setInterval(function () {
        count++;
        if (tryUpdate() || count >= 50) clearInterval(iv);
      }, 100);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
  </script>
  <script src="/scripts/progress.js" defer></script>
  <script src="/scripts/continue-banner.js" defer></script>
  <script src="/scripts/section-progress.js" defer></script>
  <script is:inline>
    document.querySelector('[data-toggle-menu]')?.addEventListener('click', function() {
      var nav = this.closest('.header__nav');
      var links = nav?.querySelector('.header__links');
      var isOpen = this.classList.contains('header__toggle--open');
      if (links) {
        this.classList.toggle('header__toggle--open');
        links.classList.toggle('header__links--open');
        this.setAttribute('aria-label', isOpen ? '{t.menuToggleClose}' : '{t.menuToggleOpen}');
      }
    });
  </script>
</body>
</html>
