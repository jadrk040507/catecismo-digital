<tr><td style="padding:8px;border:1px solid var(--border)">Blessed are the <strong>sophisticated</strong></td><td style="padding:8px;border:1px solid var(--border)"><p style="border-bottom:1px solid var(--border);margin-bottom:4px">&nbsp;</p></td></tr>
