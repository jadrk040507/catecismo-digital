    <a href="/catecismo-digital/es/sacramentos/11-la-liturgia/" style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: var(--text); transition: all 0.2s;"
       onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
      <span style="font-size: 1.2rem; min-width: 36px; font-weight: 700; color: var(--accent);">11</span>
      <div>
        <div style="font-weight: 600;">La Liturgia</div>
        <div style="font-size: 0.82rem; color: var(--text-muted);">CIC 1066-1134 &middot; El centro de la vida cristiana</div>
