---
export interface Props {
  title: string;
  cic: string;
  scripture: string;
}

const { title, cic, scripture } = Astro.props;
const path = Astro.url.pathname;
const isEn = path.startsWith('/catecismo-digital/en');
// Toggle goes to section index in the other language
const toggleHref = isEn ? '/catecismo-digital/es/' : '/catecismo-digital/en/';
const toggleLabel = isEn ? 'ES' : 'EN';
---
<!DOCTYPE html>
<html lang={Astro.currentLocale || 'es'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>{title} &mdash; Proyecto Catecismo</title>
  <meta name="description" content="Catequesis catolica gratuita" />
  <link rel="icon" type="image/svg+xml" href="/catecismo-digital/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/catecismo-digital/styles/global.css" />
</head>
<body>
  <header class="header">
    <nav class="header__nav">
      <a href="/catecismo-digital/" class="header__logo">
        <span class="header__logo-icon">+</span>
        <span>Proyecto Catecismo</span>
      </a>
      <button class="header__toggle" data-toggle-menu aria-label="Abrir menú" type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="header__links">
        <a href="/catecismo-digital/" class="header__link">Inicio</a>
        <a href="/catecismo-digital/es/credo/" class="header__link">Credo</a>
        <a href="/catecismo-digital/es/sacramentos/" class="header__link">Sacramentos</a>
        <a href="/catecismo-digital/es/moral/" class="header__link">Moral</a>
        <a href="/catecismo-digital/es/oracion/" class="header__link">Oración</a>
        <a href={toggleHref} class="header__link header__link--lang">{toggleLabel}</a>
      </div>
    </nav>
  </header>

  <main class="main">
    <header class="lesson-header">
      <div class="lesson-header__ref">
        <span>{cic}</span>
        <span>{scripture}</span>
      </div>
      <h1 class="lesson-header__title">{title}</h1>
      <div class="tts-controls">
        <button class="tts-btn tts-btn--skip" data-skip-back aria-label="Retroceder 10 segundos" title="Atrás 10s">
          <svg class="tts-btn__icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
            <text x="12" y="14" text-anchor="middle" font-size="6" font-weight="bold">10</text>
          </svg>
        </button>
        <button class="tts-btn tts-btn--play" data-play aria-label="Escuchar esta clase">
          <svg class="tts-btn__icon tts-btn__icon--play" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg class="tts-btn__icon tts-btn__icon--pause" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="display:none">
            <rect x="6" y="4" width="4" height="16"/>
            <rect x="14" y="4" width="4" height="16"/>
          </svg>
          <span class="tts-btn__label">Escuchar</span>
        </button>
        <button class="tts-btn tts-btn--skip" data-skip-forward aria-label="Adelantar 10 segundos" title="Adelante 10s">
          <svg class="tts-btn__icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M12 5V1l5 5-5 5V7c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z"/>
            <text x="12" y="14" text-anchor="middle" font-size="6" font-weight="bold">10</text>
          </svg>
        </button>
        <button class="tts-btn tts-btn--settings" data-tts-settings aria-label="Configuración de voz" title="Configuración">
          <svg class="tts-btn__icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
          </svg>
        </button>
      </div>
    </header>

    <slot />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <p class="footer__text">Gratuito &middot; Publico &middot; Catolico &middot; <a href="https://github.com/jadrk040507/catecismo-digital" class="footer__link">GitHub</a></p>
      <p class="footer__text footer__text--small">Basado en el Catecismo de la Iglesia Catolica &middot; Directorio para la Catequesis (2020)</p>
    </div>
  </footer>

  <!-- TTS Settings Modal -->
  <div id="tts-modal" class="tts-modal" style="display:none">
    <div class="tts-modal__content">
      <h3 class="tts-modal__title">Configuración de voz</h3>
      <label class="tts-modal__option">
        <input type="checkbox" id="tts-hf-toggle" />
        <span>Voz mejorada (Hugging Face)</span>
      </label>
      <div id="tts-hf-config" class="tts-modal__config" style="display:none">
        <label for="tts-hf-token">Token de API:</label>
        <input type="password" id="tts-hf-token" placeholder="hf_xxxxx..." class="tts-modal__input" />
        <small class="tts-modal__hint">Obtén tu token en <a href="https://huggingface.co/settings/tokens" target="_blank">huggingface.co/settings/tokens</a></small>
      </div>
      <div class="tts-modal__actions">
        <button id="tts-modal-save" class="tts-modal__btn tts-modal__btn--primary">Guardar</button>
        <button id="tts-modal-close" class="tts-modal__btn">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- TTS Audio element for Hugging Face -->
  <audio id="tts-audio" style="display:none"></audio>

  <!-- TTS: Enhanced player with skip + HF support -->
  <script is:inline>
(function() {
  // Elements
  const playBtn = document.querySelector('[data-play]');
  const skipBackBtn = document.querySelector('[data-skip-back]');
  const skipForwardBtn = document.querySelector('[data-skip-forward]');
  const settingsBtn = document.querySelector('[data-tts-settings]');
  const modal = document.getElementById('tts-modal');
  const hfToggle = document.getElementById('tts-hf-toggle');
  const hfConfig = document.getElementById('tts-hf-config');
  const hfTokenInput = document.getElementById('tts-hf-token');
  const modalSave = document.getElementById('tts-modal-save');
  const modalClose = document.getElementById('tts-modal-close');
  const audioEl = document.getElementById('tts-audio');

  if (!playBtn) return;

  // State
  let speaking = false;
  let paused = false;
  let utterance = null;
  let currentCharIndex = 0;
  let fullText = '';
  let useHuggingFace = false;
  let hfToken = '';
  let audioBlobUrl = null;

  // Load settings from localStorage
  function loadSettings() {
    try {
      useHuggingFace = localStorage.getItem('tts-use-hf') === 'true';
      hfToken = localStorage.getItem('tts-hf-token') || '';
      if (hfToggle) hfToggle.checked = useHuggingFace;
      if (hfTokenInput) hfTokenInput.value = hfToken;
      if (hfConfig) hfConfig.style.display = useHuggingFace ? 'block' : 'none';
    } catch(e) {}
  }
  loadSettings();

  // Modal handlers
  if (settingsBtn) {
    settingsBtn.addEventListener('click', () => {
      if (modal) modal.style.display = 'flex';
    });
  }

  if (hfToggle) {
    hfToggle.addEventListener('change', () => {
      if (hfConfig) hfConfig.style.display = hfToggle.checked ? 'block' : 'none';
    });
  }

  if (modalSave) {
    modalSave.addEventListener('click', () => {
      useHuggingFace = hfToggle ? hfToggle.checked : false;
      hfToken = hfTokenInput ? hfTokenInput.value : '';
      try {
        localStorage.setItem('tts-use-hf', useHuggingFace);
        localStorage.setItem('tts-hf-token', hfToken);
      } catch(e) {}
      if (modal) modal.style.display = 'none';
    });
  }

  if (modalClose) {
    modalClose.addEventListener('click', () => {
      if (modal) modal.style.display = 'none';
    });
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.style.display = 'none';
    });
  }

  // Get text content
  function getText() {
    const main = document.querySelector('.main');
    if (!main) return '';
    const clone = main.cloneNode(true);
    clone.querySelectorAll('.tts-btn, .tts-controls, .downloads, .lesson-header__ref, script, style, .tts-modal').forEach(el => el.remove());
    const text = clone.textContent || '';
    return text.replace(/\s+/g, ' ').trim();
  }

  // Find best Spanish voice
  function getBestVoice() {
    if (!('speechSynthesis' in window)) return null;
    const voices = window.speechSynthesis.getVoices();
    
    // Priority: Google Spanish > Microsoft Spanish > Any Spanish
    let googleVoice = voices.find(v => v.name.includes('Google') && v.lang.startsWith('es'));
    if (googleVoice) return googleVoice;
    
    let msVoice = voices.find(v => v.name.includes('Microsoft') && v.lang.startsWith('es'));
    if (msVoice) return msVoice;
    
    let anySpanish = voices.find(v => v.lang.startsWith('es'));
    if (anySpanish) return anySpanish;
    
    return null;
  }

  // Update UI
  function updateUI(state) {
    const playIcon = playBtn.querySelector('.tts-btn__icon--play');
    const pauseIcon = playBtn.querySelector('.tts-btn__icon--pause');
    const label = playBtn.querySelector('.tts-btn__label');
    
    if (state === 'playing') {
      playBtn.classList.add('tts-btn--playing');
      if (playIcon) playIcon.style.display = 'none';
      if (pauseIcon) pauseIcon.style.display = 'block';
      if (label) label.textContent = 'Pausar';
    } else if (state === 'paused') {
      playBtn.classList.add('tts-btn--playing');
      if (playIcon) playIcon.style.display = 'block';
      if (pauseIcon) pauseIcon.style.display = 'none';
      if (label) label.textContent = 'Continuar';
    } else {
      playBtn.classList.remove('tts-btn--playing');
      if (playIcon) playIcon.style.display = 'block';
      if (pauseIcon) pauseIcon.style.display = 'none';
      if (label) label.textContent = 'Escuchar';
    }
  }

  // Stop all playback
  function stopAll() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    if (audioEl) {
      audioEl.pause();
      audioEl.src = '';
    }
    if (audioBlobUrl) {
      URL.revokeObjectURL(audioBlobUrl);
      audioBlobUrl = null;
    }
    speaking = false;
    paused = false;
    currentCharIndex = 0;
    updateUI('stopped');
  }

  // Web Speech API playback
  function playWebSpeech(startIndex = 0) {
    if (!('speechSynthesis' in window)) {
      alert('Tu navegador no soporta síntesis de voz');
      return;
    }

    const text = startIndex > 0 ? fullText.substring(startIndex) : getText();
    if (!text) return;

    if (startIndex === 0) fullText = text;

    utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'es-MX';
    utterance.rate = 0.9;
    utterance.pitch = 1.0;

    const bestVoice = getBestVoice();
    if (bestVoice) utterance.voice = bestVoice;

    utterance.onstart = () => {
      speaking = true;
      paused = false;
      updateUI('playing');
    };

    utterance.onboundary = (event) => {
      if (event.name === 'word' || event.name === 'sentence') {
        currentCharIndex = startIndex + event.charIndex;
      }
    };

    utterance.onend = () => {
      speaking = false;
      paused = false;
      currentCharIndex = 0;
      updateUI('stopped');
    };

    utterance.onerror = () => {
      speaking = false;
      paused = false;
      updateUI('stopped');
    };

    window.speechSynthesis.speak(utterance);
  }

  // Hugging Face TTS playback
  async function playHuggingFace(startIndex = 0) {
    const text = startIndex > 0 ? fullText.substring(startIndex) : getText();
    if (!text) return;

    if (startIndex === 0) fullText = text;

    if (!hfToken) {
      alert('Configura tu token de Hugging Face en el botón de configuración ⚙️');
      return;
    }

    try {
      updateUI('playing');
      
      const response = await fetch('https://api-inference.huggingface.co/models/facebook/mms-tts-spa', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${hfToken}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ inputs: text.substring(0, 5000) }) // Limit text length
      });

      if (!response.ok) {
        throw new Error('Error en la API de Hugging Face');
      }

      const blob = await response.blob();
      audioBlobUrl = URL.createObjectURL(blob);
      audioEl.src = audioBlobUrl;
      audioEl.play();
      speaking = true;
      paused = false;
      
    } catch (err) {
      console.error('Hugging Face TTS error:', err);
      alert('Error al generar audio. Verifica tu token de API.');
      updateUI('stopped');
    }
  }

  // Audio element events
  if (audioEl) {
    audioEl.onended = () => {
      speaking = false;
      paused = false;
      currentCharIndex = 0;
      updateUI('stopped');
    };
    
    audioEl.onplay = () => {
      speaking = true;
      paused = false;
      updateUI('playing');
    };
    
    audioEl.onpause = () => {
      paused = true;
      updateUI('paused');
    };
  }

  // Play/Pause button
  playBtn.addEventListener('click', () => {
    if (speaking && !paused) {
      // Pause
      if (useHuggingFace && audioEl) {
        audioEl.pause();
      } else if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        speaking = false;
      }
      paused = true;
      updateUI('paused');
    } else if (paused) {
      // Resume
      if (useHuggingFace && audioEl) {
        audioEl.play();
      } else {
        playWebSpeech(currentCharIndex);
      }
    } else {
      // Start fresh
      if (useHuggingFace) {
        playHuggingFace();
      } else {
        playWebSpeech();
      }
    }
  });

  // Skip back 10s
  if (skipBackBtn) {
    skipBackBtn.addEventListener('click', () => {
      if (!speaking && !paused) return;
      
      if (useHuggingFace && audioEl) {
        audioEl.currentTime = Math.max(0, audioEl.currentTime - 10);
      } else {
        // Estimate position based on charIndex (rough approximation)
        const estimatedCharsPerSecond = 15; // ~15 chars per second at 0.9 rate
        const currentPos = currentCharIndex;
        const backChars = estimatedCharsPerSecond * 10;
        const newPos = Math.max(0, currentPos - backChars);
        stopAll();
        playWebSpeech(newPos);
      }
    });
  }

  // Skip forward 10s
  if (skipForwardBtn) {
    skipForwardBtn.addEventListener('click', () => {
      if (!speaking && !paused) return;
      
      if (useHuggingFace && audioEl) {
        audioEl.currentTime = Math.min(audioEl.duration || 0, audioEl.currentTime + 10);
      } else {
        const estimatedCharsPerSecond = 15;
        const currentPos = currentCharIndex;
        const forwardChars = estimatedCharsPerSecond * 10;
        const newPos = currentPos + forwardChars;
        if (newPos < fullText.length) {
          stopAll();
          playWebSpeech(newPos);
        } else {
          stopAll();
        }
      }
    });
  }

  // Load voices when available
  if ('speechSynthesis' in window) {
    window.speechSynthesis.onvoiceschanged = () => {};
    // Trigger voice loading
    window.speechSynthesis.getVoices();
  }
})();

  // Hamburger toggle
  document.querySelector('[data-toggle-menu]')?.addEventListener('click', function() {
    var nav = this.closest('.header__nav');
    var links = nav?.querySelector('.header__links');
    if (links) {
      this.classList.toggle('header__toggle--open');
      links.classList.toggle('header__links--open');
      this.setAttribute('aria-label', this.classList.contains('header__toggle--open') ? 'Cerrar menú' : 'Abrir menú');
    }
  });
</script>
</body>
</html>
